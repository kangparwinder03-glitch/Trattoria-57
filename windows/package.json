{
  "name": "trattoria57-windows",
  "productName": "Trattoria 57",
  "version": "1.0.0",
  "description": "Trattoria 57 for Windows: the restaurant app, printers and backups",
  "main": "main.js",
  "author": "Trattoria 57",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/run-local.js",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "uk.trattoria57.windows",
    "productName": "Trattoria 57",
    "files": ["main.js", "printer.html", "src/**", "assets/**", "package.json"],
    "extraResources": [{ "from": "rawprint.ps1", "to": "rawprint.ps1" }],
    "win": { "target": "nsis", "icon": "assets/icon.ico" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Trattoria 57",
      "runAfterFinish": true,
      "artifactName": "T57-Windows-Setup.exe",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  }
}
